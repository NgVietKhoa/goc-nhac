# Mọi biến đều tùy chọn. Trên Vercel: Project Settings → Environment Variables.

# ===== Khóa app bằng mật khẩu (bỏ trống = không cần đăng nhập) =====
# APP_PASSWORD=
# Bắt buộc khi có APP_PASSWORD: chuỗi ngẫu nhiên >= 32 ký tự để ký cookie.
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# ===== Proxy khi YouTube chặn IP máy chủ =====
# Request lấy link audio + tải audio sẽ đi qua proxy (http:// hoặc https://).
# YT_PROXY=http://user:pass@host:port
# Đặt 1 để MỌI request tới YouTube (cả tìm kiếm, album…) đều qua proxy.
# YT_PROXY_ALL=0

# ===== Xử lý khi YouTube thay đổi =====
# Thứ tự client InnerTube dùng để lấy luồng audio (client đầu tiên tải được trọn bài sẽ được dùng).
# YT_CLIENTS=VISIONOS,YTMUSIC,ANDROID_VR,IOS,MWEB
# YT_PO_TOKEN=
# YT_VISITOR_DATA=
# YT_PLAYER_ID=
# YT_CACHE_DIR=

# ===== Khác =====
# Cổng của server Node khi chạy local / Docker.
PORT=3001
# Chỉ đặt khi frontend gọi API ở domain KHÁC. Vd: https://goc-nhac.vercel.app
# CORS_ORIGIN=
