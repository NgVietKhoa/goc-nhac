# ===== Bắt buộc =====
# Mật khẩu để mở khóa app (đăng nhập một lần, trình duyệt được ghi nhớ 30 ngày).
APP_PASSWORD=doi-mat-khau-nay
# Chuỗi ngẫu nhiên >= 32 ký tự để ký cookie. Tạo bằng: openssl rand -hex 32
# Đổi giá trị này = đăng xuất mọi trình duyệt.
SESSION_SECRET=

# Kết nối Postgres cho server Node (dev local / tự host).
# Trên Supabase Edge Function KHÔNG cần: Supabase tự cấp SUPABASE_DB_URL.
# Lấy ở Supabase Dashboard → Connect → "Transaction pooler" (cổng 6543), hoặc Postgres local.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# ===== Tùy chọn: xử lý khi YouTube thay đổi =====
# Thứ tự client InnerTube dùng để lấy luồng audio (client đầu tiên tải được trọn bài sẽ được dùng).
# YT_CLIENTS=VISIONOS,YTMUSIC,ANDROID_VR,IOS,MWEB
# PO token + visitor data (khi YouTube đòi "xác minh không phải bot" hoặc chặn tải quá 1 MB).
# YT_PO_TOKEN=
# YT_VISITOR_DATA=
# Ép dùng một phiên bản player cụ thể (khi player mới làm hỏng việc decipher).
# YT_PLAYER_ID=
# Thư mục cache của youtubei.js (mặc định ./data/youtubei-cache trên Node, /tmp/youtubei trên Supabase).
# YT_CACHE_DIR=

# ===== Tùy chọn khác =====
# Cổng của server Node.
PORT=3001
# Chỉ đặt khi frontend gọi API ở domain KHÁC (không dùng rewrite của Vercel). Vd: https://goc-nhac.vercel.app
# CORS_ORIGIN=
